#!/bin/bash

appName=$(basename "$0")

usage() {
	echo "usage: $appName appName [action]" >&2
	echo '  appName: Display name like Finder, Mail, Code, etc.'
	echo '  action: One of revert or light'
	exit 1
}

[ -n "$1" -a "$1" != -h -a "$1" != --help ] || usage

bid=$(appid "$1")
[ $? -eq 0 -a ! -z "$bid" ] || {
	echo "error: invalid app '$1'" >&2
	exit 2
}

case "$2" in
	revert )
		echo "$bid: revert"
		defaults delete "$bid" NSRequiresAquaSystemAppearance
		;;
	light )
		echo "$bid: force Light Mode (for badly written apps)"
		defaults write "$bid" NSRequiresAquaSystemAppearance -bool YES
		;;
	'' )
		echo "$bid: force Dark Mode"
		defaults write "$bid" NSRequiresAquaSystemAppearance -bool NO
		;;
	* )
		usage
		;;
esac
